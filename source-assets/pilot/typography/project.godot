; Isolated RC-011 fallback typography renderer. Never imported by the main project.
config_version=5

[application]
config/name="RC-011 Typography Evidence"

[display]
window/size/viewport_width=1100
window/size/viewport_height=1360
window/size/window_width_override=550
window/size/window_height_override=680

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
