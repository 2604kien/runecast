float approved_actor_coverage(vec2 p) {
    // Both sprite transforms reach the same atlas coordinates; stabilize
    // subpixel float differences before the shared edge test.
    p = floor(p * 64.0 + vec2(0.5)) / 64.0;
    if (p.x < 290.0 || p.x > 574.0 || p.y < 149.0 || p.y > 432.0) { return 0.0; }
    bool inside = false;
    int previous = APPROVED_ACTOR_POINT_COUNT - 1;
    for (int current = 0; current < APPROVED_ACTOR_POINT_COUNT; current++) {
        vec2 a = APPROVED_ACTOR_POINTS[current];
        vec2 b = APPROVED_ACTOR_POINTS[previous];
        if ((a.y > p.y) != (b.y > p.y)) {
            float crossing = (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x;
            if (p.x < crossing) { inside = !inside; }
        }
        previous = current;
    }
    return inside ? 1.0 : 0.0;
}
